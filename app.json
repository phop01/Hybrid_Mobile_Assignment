{
  "expo": {
    "name": "NK Today",
    "slug": "nktoday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nktoday",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.phop.nktoday",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.phop.nktoday",
      "adaptiveIcon": {
        "backgroundColor": "#E3F0F7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F5F8C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NK Today ใช้กล้องเฉพาะตอนคุณกดถ่ายรูป: รูปยืนยันการเข้าร่วมกิจกรรม รูปปัญหาที่แจ้งซ่อม และรูปหลังซ่อมเสร็จ",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NK Today ใช้ตำแหน่งตอนเช็กอินกิจกรรม ตอนปักหมุดจุดที่แจ้งซ่อม และตอนดูเส้นทางในแอป ไม่ติดตามตำแหน่งเบื้องหลัง"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NK Today เปิดคลังรูปเฉพาะตอนคุณกดเลือกรูป เช่น รูปปัญหาที่จะแจ้งซ่อมหรือรูปหลักฐานการเข้าร่วมกิจกรรม",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}